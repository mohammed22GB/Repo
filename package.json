  "scripts": {
    "start": "react-scripts --max_old_space_size=4096 start",
    "build:dev": "dotenv -e .env.development react-scripts build",
    "build": "npm run generate-meta-tag && react-scripts --max_old_space_size=4096 build",
    "eslint": "eslint ./src --ext .js,.jsx --ignore-pattern node_modules/",
    "test": "react-scripts test --verbose=true",
    "test:preview": "jest-preview",
    "test:coverage": "npm test -- --coverage --collectCoverageFrom=./src/**",
    "eject": "react-scripts eject",
    "generate-meta-tag": "node ./node_modules/react-cache-buster/dist/generate-meta-tag.js",
    "start:docker": "docker compose up",
    "prepare": "husky",
    "knip": "knip --production --files"
  },
  "jest": {
    "transform": {
      "^.+\\.(js|jsx|mjs|cjs)$": "babel-jest",
      "^.+\\.(ts|tsx)$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,mjs,ts,tsx}",
      "!**/node_modules/**"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@syncfusion|axios|pdfjs-dist|query-string)/)"
    ],
    "moduleNameMapper": {
      "react-toastify/dist/ReactToastify.css": "<rootDir>/src/test-utilities/custom-jest.js",
      "react-phone-input-2/lib/style.css": "<rootDir>/src/test-utilities/custom-jest.js",
      "react-datepicker/dist/react-datepicker.css": "<rootDir>/src/test-utilities/custom-jest.js",
      "react-grid-layout/css/styles.css": "<rootDir>/src/test-utilities/custom-jest.js",
      "react-to-pdf": "<rootDir>/src/test-utilities/custom-jest.js",
      "@amcharts/amcharts5": "<rootDir>/src/test-utilities/custom-jest.js",
      "react-resizable/css/styles.css": "<rootDir>/src/test-utilities/custom-jest.js",
      "jspdf": "<rootDir>/src/test-utilities/custom-jest.js",
      "query-string": "<rootDir>/src/test-utilities/custom-jest.js"
    }
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
